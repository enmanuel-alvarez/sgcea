# SGCEA - .htaccess (public/)
# Front Controller y reglas de reescritura

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirigir a HTTPS en producción (descomentar si usa SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # De lo contrario, redirigir al Front Controller
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
