# ============================================
# SGCEA - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y ajusta las credenciales
# ============================================

# Aplicación
APP_NAME="SGCEA"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost/sgcea/public"
APP_TIMEZONE="America/Caracas"
APP_LANG=es
APP_CURRENCY=VES
APP_VERSION="1.0.0"

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgcea
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# Sesión y Seguridad
SESSION_LIFETIME=3600
SESSION_SECURE=false

