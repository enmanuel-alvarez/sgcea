# SGCEA - .gitignore

# Archivos de configuración con credenciales
config/database.php

# Logs y sesiones
storage/logs/*
storage/sessions/*
!storage/logs/.gitkeep
!storage/sessions/.gitkeep

# Archivos temporales
*.tmp
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db

# Node modules (si se usan herramientas de build)
node_modules/
